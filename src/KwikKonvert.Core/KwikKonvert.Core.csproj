<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KwikKonvert.Core: everything that is NOT Windows UI.
    No Windows-only APIs live here, so the conversion queue, format rules and
    preferences can be built and tested on any OS.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KwikKonvert.Core</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
